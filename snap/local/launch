#!/bin/sh
# Map `snap set wifi-provision <key>=<value>` options onto wifi-provision's
# environment variables, then exec the binary. Unset options are left alone so
# the binary's own defaults apply; flags passed to `snap run` still win.
set -e

opt() { # opt <snap-key> <ENV_VAR>
	v="$(snapctl get "$1")"
	if [ -n "$v" ]; then
		export "$2=$v"
	fi
}

opt interface         PORTAL_INTERFACE
opt ssid              PORTAL_SSID
opt passphrase        PORTAL_PASSPHRASE
opt gateway           PORTAL_GATEWAY
opt dhcp-range        PORTAL_DHCP_RANGE
opt listening-port    PORTAL_LISTENING_PORT
opt activity-timeout  ACTIVITY_TIMEOUT
opt country           PORTAL_COUNTRY

# Only show the portal on devices with no Wi-Fi configured, so the boot service
# leaves provisioned devices alone. `snap set wifi-provision reprovision=true`
# (see the configure hook) requests one run that skips this check.
if [ "$(snapctl get reprovision)" = "true" ]; then
	snapctl unset reprovision
	export PORTAL_SKIP_IF_PROVISIONED=false
else
	export PORTAL_SKIP_IF_PROVISIONED=true
fi

exec "$SNAP/bin/wifi-provision" "$@"
