#!/bin/sh
# Installed as connect-plug-<plug> for each plug the service needs. When the
# last of them is connected, (re)start the service: the boot service already
# ran at install time, before any plugs were connected, and exited.
set -e

this="${0##*/connect-plug-}"
for plug in network-control network-setup-control firewall-control; do
	[ "$plug" = "$this" ] && continue # being connected now
	snapctl is-connected "$plug" || exit 0
done
snapctl restart wifi-provision.wifi-provision
